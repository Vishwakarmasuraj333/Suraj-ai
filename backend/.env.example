# Application
APP_NAME="SURaj AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-strong-64-char-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL primary; sqlite+aiosqlite supported for local zero-dependency dev)
DATABASE_URL=postgresql+asyncpg://suraj:suraj_password@localhost:5432/suraj_ai
# Local dev fallback example:
# DATABASE_URL=sqlite+aiosqlite:///./suraj_ai.db

# Redis distributed rate limiting (leave empty for local dev in-memory fallback)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEV_FALLBACK=true

# LLM Providers (configure one or more; keys are NEVER sent to frontend)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Image Generation (openai or gemini)
DEFAULT_IMAGE_PROVIDER=openai
DEFAULT_IMAGE_MODEL=dall-e-3

# Storage & Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_DAILY_TOKENS=250000

# Real SMTP Email Delivery (required for Email OTP & Password Reset)
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Real Payment Gateways (optional; never simulated when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

